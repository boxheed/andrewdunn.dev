---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import PostNavigation from '../components/PostNavigation.astro';
import SeriesIndex from '../components/SeriesIndex.astro';

interface Props {
  title: string;
  date: Date;
  prev?: { title: string; url: string } | null;
  next?: { title: string; url: string } | null;
  series?: {
    title: string;
    articles: Array<{ title: string; url: string; isCurrent: boolean }>;
  } | null;
}

const { title, date, prev, next, series } = Astro.props;
---

<BaseLayout title={`${title} | Andrew Dunn`}>
  <article>
    <header style="margin-bottom: 64px;">
      <h1 class="post-title" style="margin-bottom: 1rem;">{title}</h1>
      <time datetime={date.toISOString()} style="color: var(--text-muted); font-size: 1.125rem;">
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>

    {series && <SeriesIndex seriesTitle={series.title} articles={series.articles} />}

    <div class="post-content">
      <slot />
    </div>
    <PostNavigation prev={prev} next={next} />
  </article>
</BaseLayout>

<style>
  /* Basic typography margins for markdown content */
  .post-content :global(h2) {
    margin-top: 64px;
    margin-bottom: 1.5rem;
  }
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }
</style>
