---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import PostNavigation from '../components/PostNavigation.astro';
import SeriesIndex from '../components/SeriesIndex.astro';

interface Props {
  title: string;
  pubDate: Date;
  updatedDate?: Date;
  prev?: { title: string; url: string } | null;
  next?: { title: string; url: string } | null;
  series?: {
    title: string;
    articles: Array<{ title: string; url: string; isCurrent: boolean }>;
  } | null;
}

const { title, pubDate, updatedDate, prev, next, series } = Astro.props;
---

<BaseLayout title={`${title} | Andrew Dunn`}>
  <article>
    <header style="margin-bottom: 64px;">
      <h1 class="post-title" style="margin-bottom: 1rem;">{title}</h1>
      <div style="color: var(--text-muted); font-size: 1.125rem;">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {
          updatedDate && (
            <span>
              {' '}
              (Updated:{' '}
              <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              )
            </span>
          )
        }
      </div>
    </header>

    {series && <SeriesIndex seriesTitle={series.title} articles={series.articles} />}

    <div class="post-content">
      <slot />
    </div>
    <PostNavigation prev={prev} next={next} />
  </article>
</BaseLayout>

<style>
  /* Basic typography margins for markdown content */
  .post-content :global(h2) {
    margin-top: 64px;
    margin-bottom: 1.5rem;
  }
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }
</style>
