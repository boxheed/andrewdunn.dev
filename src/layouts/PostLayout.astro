---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
---

<BaseLayout title={`${title} | Purity & Void`}>
  <article>
    <header style="margin-bottom: 64px;">
      <h1 class="post-title" style="margin-bottom: 1rem;">{title}</h1>
      <time datetime={date.toISOString()} style="color: var(--text-muted); font-size: 1.125rem;">
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Basic typography margins for markdown content */
  .post-content :global(h2) {
    margin-top: 64px;
    margin-bottom: 1.5rem;
  }
  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }
</style>
