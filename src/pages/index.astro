---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const primaryPosts = posts.filter((post) => post.data.pubDate.getFullYear() >= 2024);
const archivePosts = posts.filter((post) => post.data.pubDate.getFullYear() < 2024);
---

<BaseLayout title="Andrew Dunn">
  <header class="masthead">
    <h1>Andrew Dunn</h1>
    <p class="masthead-deck">The mechanics of software delivery and production systems.</p>
  </header>
  <div class="posts">
    {
      primaryPosts.map((post) => (
        <PostPreview
          title={post.data.title}
          pubDate={post.data.pubDate}
          slug={post.id}
          series={post.data.series}
        />
      ))
    }
  </div>

  {
    archivePosts.length > 0 && (
      <section class="archive-section" aria-labelledby="archive-heading">
        <h2 id="archive-heading" class="archive-heading">
          Archive (2015–2023)
        </h2>
        <ul class="archive-list">
          {archivePosts.map((post) => (
            <li class="archive-item">
              <a href={`/blog/${post.id}`} class="archive-link">
                {post.data.title}
              </a>
              <time datetime={post.data.pubDate.toISOString()} class="archive-date">
                {post.data.pubDate.getFullYear()}
              </time>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
