---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Andrew Dunn">
  <h1 class="hero-title" style="margin-top: 64px; margin-bottom: 96px;">Signal.</h1>
  <div class="posts">
    {
      posts.map((post) => (
        <PostPreview title={post.data.title} pubDate={post.data.pubDate} slug={post.id} />
      ))
    }
  </div>
</BaseLayout>
