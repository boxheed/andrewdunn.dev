---
// src/pages/series/[id].astro
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const seriesMap = new Map<
    string,
    {
      id: string;
      title: string;
      description?: string;
      posts: CollectionEntry<'blog'>[];
    }
  >();

  for (const post of posts) {
    if (post.data.series) {
      const { id, title, description } = post.data.series;
      if (!seriesMap.has(id)) {
        seriesMap.set(id, {
          id,
          title,
          description,
          posts: [],
        });
      }
      const group = seriesMap.get(id)!;
      if (!group.description && description) {
        group.description = description;
      }
      group.posts.push(post);
    }
  }

  return Array.from(seriesMap.values()).map((series) => {
    const sortedPosts = series.posts.sort(
      (a, b) =>
        (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0) ||
        a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
    );

    return {
      params: { id: series.id },
      props: {
        seriesId: series.id,
        seriesTitle: series.title,
        seriesDescription: series.description,
        posts: sortedPosts,
      },
    };
  });
}

interface Props {
  seriesId: string;
  seriesTitle: string;
  seriesDescription?: string;
  posts: CollectionEntry<'blog'>[];
}

const { seriesTitle, seriesDescription, posts } = Astro.props;

const sortedPosts = [...posts].sort(
  (a, b) =>
    new Date((a.data as any).date ?? a.data.pubDate).getTime() -
    new Date((b.data as any).date ?? b.data.pubDate).getTime(),
);
const latestPost = sortedPosts[sortedPosts.length - 1];
if (latestPost && !(latestPost.data as any).date) {
  (latestPost.data as any).date = latestPost.data.pubDate;
}
const formattedLatestDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date((latestPost.data as any).date));
---

<BaseLayout
  title={`${seriesTitle} | Series | Andrew Dunn`}
  description={seriesDescription || `A multi-part series on ${seriesTitle}.`}
>
  <div class="series-hub">
    <header class="series-header">
      <h1 class="post-title">{seriesTitle}</h1>

      <div class="series-meta">
        <time datetime={new Date((latestPost.data as any).date).toISOString()}
          >{formattedLatestDate}</time
        >
      </div>
    </header>

    <div class="series-feed" role="feed" aria-label="Series chapters">
      {
        posts.map((post, index) => {
          const partIndex = post.data.series?.order ?? index + 1;
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article class="series-part-entry">
              <h2 class="post-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <span>Part {partIndex}</span>
                <span class="meta-sep" aria-hidden="true">
                  ·
                </span>
                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .series-hub {
    width: 100%;
    margin-top: 0;
  }

  .series-header {
    margin-top: 0;
    margin-bottom: 4rem;
  }

  .series-header .post-title {
    font-size: clamp(2.25rem, 5vw, 2.75rem);
    line-height: 1.1;
    margin-bottom: 0;
  }

  .series-meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary, var(--text-muted));
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .series-feed {
    display: flex;
    flex-direction: column;
  }

  .series-part-entry {
    margin-bottom: 3.5rem;
  }

  .series-part-entry:last-child {
    margin-bottom: 0;
  }

  .series-part-entry .post-title {
    font-size: clamp(1.35rem, 3vw, 1.5rem);
    line-height: 1.25;
    margin-bottom: 0;
  }

  .series-part-entry .post-meta {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, var(--text-muted));
  }
</style>
