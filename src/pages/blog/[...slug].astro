---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sortedPosts = [...posts].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return sortedPosts.map((post, index) => {
    const prev =
      index > 0
        ? {
            title: sortedPosts[index - 1].data.title,
            url: `/blog/${sortedPosts[index - 1].id}`,
          }
        : null;
    const next =
      index < sortedPosts.length - 1
        ? {
            title: sortedPosts[index + 1].data.title,
            url: `/blog/${sortedPosts[index + 1].id}`,
          }
        : null;

    // Series linkage
    let series = null;
    if (post.data.series) {
      const seriesId = post.data.series.id;
      const seriesPosts = sortedPosts.filter((p) => p.data.series && p.data.series.id === seriesId);
      series = {
        title: post.data.series.title,
        articles: seriesPosts.map((p) => ({
          title: p.data.title,
          url: `/blog/${p.id}`,
          isCurrent: p.id === post.id,
        })),
      };
    }

    return {
      params: { slug: post.id },
      props: { post, prev, next, series },
    };
  });
}

const { post, prev, next, series } = Astro.props;
const { Content } = await render(post);
---

<PostLayout title={post.data.title} date={post.data.date} prev={prev} next={next} series={series}>
  <Content components={{ pre: CodeBlock }} />
</PostLayout>
