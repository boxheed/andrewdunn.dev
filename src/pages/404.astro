---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found">
  <div style="text-align: center; margin-top: 128px;">
    <h1 class="hero-title" style="margin-bottom: 2rem;">404</h1>
    <p style="color: var(--text-muted); font-size: 1.125rem; margin-bottom: 2rem;">
      The void has consumed this page.
    </p>
    <a
      href="/"
      style="color: var(--accent-action); font-weight: 600;"
    >
      Return to safety
    </a>
  </div>
</BaseLayout>
