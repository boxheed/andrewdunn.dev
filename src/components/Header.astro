---
// Header.astro
---

<header role="banner" style="margin-bottom: 64px; padding: 2rem 0;">
  <nav
    role="navigation"
    style="display: flex; justify-content: space-between; align-items: center;"
  >
    <a href="/" class="site-title" style="font-weight: 700; font-size: 1.25rem;"> Andrew Dunn </a>
    <div style="display: flex; gap: 2rem; align-items: center;">
      <a href="/rss.xml">RSS</a>
      <div class="theme-selector">
        <span class="theme-label">Theme:</span>
        <button id="theme-btn-light" class="theme-btn" aria-label="Switch to Light Theme">
          Light
        </button>
        <span class="theme-separator">/</span>
        <button id="theme-btn-dark" class="theme-btn" aria-label="Switch to Dark Theme">
          Dark
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const btnLight = document.getElementById('theme-btn-light');
  const btnDark = document.getElementById('theme-btn-dark');

  const updateSelector = (isDark: boolean) => {
    if (btnLight && btnDark) {
      btnLight.setAttribute('aria-pressed', isDark ? 'false' : 'true');
      btnDark.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
  };

  const setTheme = (isDark: boolean) => {
    document.documentElement.classList.toggle('dark', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateSelector(isDark);
  };

  if (btnLight && btnDark) {
    // Initial sync
    const isDark = document.documentElement.classList.contains('dark');
    updateSelector(isDark);

    // Click listeners
    btnLight.addEventListener('click', () => setTheme(false));
    btnDark.addEventListener('click', () => setTheme(true));
  }
</script>
