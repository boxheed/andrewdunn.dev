---
// PostPreview.astro
interface Props {
  title: string;
  date: Date;
  slug: string;
}

const { title, date, slug } = Astro.props;
---

<article style="margin-bottom: 64px;">
  <h2 style="margin-bottom: 0.5rem;">
    <a href={`/blog/${slug}`}>
      {title}
    </a>
  </h2>
  <time datetime={date.toISOString()} style="color: var(--text-muted);">
    {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>
</article>
