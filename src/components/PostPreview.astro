---
// PostPreview.astro
interface SeriesInfo {
  title?: string;
  series_title?: string;
  id?: string;
  series_slug?: string;
  slug?: string;
  order?: number;
  series_part?: number;
}

interface Props {
  title: string;
  pubDate: Date;
  slug: string;
  series?: SeriesInfo;
}

const { title, pubDate, slug, series } = Astro.props;

const seriesTitle = series?.title ?? series?.series_title;
const seriesSlug = series?.id ?? series?.series_slug ?? series?.slug;
const partNumber = series?.order ?? series?.series_part;
const hasSeries = Boolean(series && seriesTitle && seriesSlug);
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-entry">
  <h2 class="post-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h2>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    {
      hasSeries && (
        <>
          <span class="meta-sep" aria-hidden="true">
            ·
          </span>
          <a href={`/series/${seriesSlug}/`} class="meta-series">
            {seriesTitle}
            {partNumber !== undefined ? `, Part ${partNumber}` : ''}
          </a>
        </>
      )
    }
  </div>
</article>
