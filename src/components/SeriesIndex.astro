---
// SeriesIndex.astro
import SeriesRail from './SeriesRail.astro';

interface Article {
  title: string;
  url: string;
  isCurrent: boolean;
  partNum?: number;
}

interface Props {
  seriesTitle: string;
  seriesId?: string;
  seriesSlug?: string;
  articles: Article[];
}

const { seriesTitle, seriesId, seriesSlug, articles } = Astro.props;
const slug = seriesSlug ?? seriesId ?? '';
---

<SeriesRail seriesTitle={seriesTitle} seriesSlug={slug} articles={articles} />
